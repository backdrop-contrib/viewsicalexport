<?php
/**
 * @file
 * Adds ical functionality to Views.
 */

/**
 * Implements hook_autoload_info().
 */
function viewsicalexport_autoload_info() {
  return array(
    'ViewsicalexportPluginStyleIcalFeed' => 'views/viewsicalexport_plugin_style_ical_feed.inc',
    'ViewsicalexportPluginRowIcalFields' => 'views/viewsicalexport_plugin_row_ical_fields.inc',
  );
}

/**
 * Implements hook_hook_info().
 */
function viewsicalexport_hook_info() {
  $hooks = array(
    'viewsicalexport_field_html_alter',
    'viewsicalexport_vevent_alter',
    'viewsicalexport_vcalendar_alter',
    'viewsicalexport_post_render_alter',
  );

  return array_fill_keys($hooks, array('group' => 'viewsicalexport'));
}

/**
 * Implements hook_views_api().
 */
function viewsicalexport_views_api() {
  return array(
    'api' => 3,
    'path' => backdrop_get_path('module', 'viewsicalexport') . '/views',
  );
}

/**
 * Implements hook_theme().
 */
function viewsicalexport_theme($existing, $type, $theme, $path) {
  return array(
    'viewsicalexport_icon' => array(
      'variables' => array('url' => NULL, 'tooltip' => NULL, 'type' => 'png'),
    ),
  );
}

/**
 * Theme function for the ical icon used by attached iCal feed.
 *
 * @param array $variables
 *   - tooltip: The tooltip to be used for the ican feed icon.
 *   - url: The url to the actual iCal feed.
 *   - type: How to display the subscribe icon.
 *   - view - The View object from which the iCal feed is being built.
 *
 * @return string
 */
function theme_viewsicalexport_icon(array $variables) {
  $output = '';
  $image_base_path = backdrop_get_path('module', 'viewsicalexport') . '/images/';
  if (empty($variables['tooltip'])) {
    $variables['tooltip'] = t('Add this event to my calendar');
  }
  $variables['alt'] = $variables['title'] = $variables['tooltip'];
  switch ($variables['type']) {
    case 'png':
      $variables['path'] = $image_base_path . '/ical-feed-icon.png';
      $image = theme('image', $variables);
      $output = "<a href='{$variables['url']}' class='ical-icon'>$image</a>";
      break;

    case 'svg':
      $variables['path'] = $image_base_path . '/ical-feed-icon.svg';
      $icon = theme('icon', array(
        'name' => 'ical-feed-icon',
        'path' => $variables['path'],
        'alt' => $variables['tooltip'],
      ));
      $output = "<a href='{$variables['url']}' class='ical-icon-svg'>$icon</a>";
      break;

    case 'svg_fill':
      $variables['path'] = $image_base_path . '/ical-feed-icon-fill.svg';
      $icon = theme('icon', array(
        'name' => 'ical-feed-icon-fill',
        'path' => $variables['path'],
        'alt' => $variables['tooltip'],
      ));
      $output = "<a href='{$variables['url']}' class='ical-icon-svg'>$icon</a>";
      break;

    default:
      // Type text.
      $output = "<a href='{$variables['url']}' class='ical-icon'>{$variables['tooltip']}</a>";
  }
  return $output;
}

/**
 * Exception used by iCal Fields for when a date field is blank.
 */
class ViewsicalexportBlankDateFieldException extends Exception {}
